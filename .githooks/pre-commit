#!/bin/sh
# ЗАМОК ГРОШЕЙ (04.10). Перед кожним комітом перевіряємо грошове ядро.
# Зміна, яка ламає «скільки сплачено», привʼязку платежів, контроль оплати
# чи Звірку, — не комітиться. Вмикається один раз на клон:
#   git config core.hooksPath .githooks
# Обійти (лише якщо справді знаєте, що робите): git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
if git diff --cached --name-only | grep -qE '^(loomiq-money-core\.js|loomiqadmin\.html|loomiq-design\.js|firestore\.rules|worker/money\.js|worker/novaposhta-proxy\.js|tests/money-)'; then
  node tests/money-core.mjs >/tmp/lq-money-core.log 2>&1 || {
    echo "✗ Грошове ядро зламано — коміт зупинено. Подробиці: /tmp/lq-money-core.log"
    grep '✗' /tmp/lq-money-core.log
    exit 1
  }
  # Правила бази — коли є емулятор (інакше тест сам каже «пропущено»).
  if git diff --cached --name-only | grep -q '^firestore\.rules$'; then
    node tests/money-rules.mjs >/tmp/lq-money-rules.log 2>&1 || {
      echo "✗ Правила бази для грошей зламано — коміт зупинено. Подробиці: /tmp/lq-money-rules.log"
      grep '✗' /tmp/lq-money-rules.log
      exit 1
    }
  fi
    # 22.10: номер замовлення — лише заброньований (orderNos).
    node tests/order-nos.mjs >/tmp/lq-order-nos.log 2>&1 || {
      echo "✗ Правила бронювання номерів зламано — коміт зупинено. Подробиці: /tmp/lq-order-nos.log"
      grep '✗' /tmp/lq-order-nos.log
      exit 1
    }
  # Оплата на карту з «!» (21.10): справжня адмінка — менеджер вписує,
  # власник підтверджує, «не дійшло» не рахується.
  if git diff --cached --name-only | grep -qE '^(loomiqadmin\.html|loomiq-design\.js|loomiq-money-core\.js|tests/card-pay\.mjs)'; then
    node tests/card-pay.mjs >/tmp/lq-card-pay.log 2>&1 || {
      echo "✗ Оплата на карту зламана — коміт зупинено. Подробиці: /tmp/lq-card-pay.log"
      grep '✗' /tmp/lq-card-pay.log
      exit 1
    }
  fi
  echo "✓ грошове ядро ціле"
fi
# КОНТРОЛЬ ОПЛАТИ ПО ФОПАХ (21.10): зміна воркера грошей чи накладних —
# прогін підставної Нової пошти по двох відправниках і воркера накладних.
if git diff --cached --name-only | grep -qE '^(worker/money\.js|worker/novaposhta-proxy\.js|tests/np-cod\.mjs|tests/np-ship\.mjs|tests/money-worker\.mjs|tests/ship-abroad\.mjs)'; then
  for t in np-cod np-ship money-worker ship-abroad; do
    node tests/$t.mjs >/tmp/lq-$t.log 2>&1 || {
      echo "✗ Нова пошта / гроші зламано ($t) — коміт зупинено. Подробиці: /tmp/lq-$t.log"
      grep '✗' /tmp/lq-$t.log
      exit 1
    }
  done
  echo "✓ контроль оплати по ФОПах цілий"
fi
# СТОРОЖ ДІАЛОГУ (19.10). Андрій: «постійні проблеми з діалогом, коли я
# зміни вношу». Зміна адмінки — прогін справжнього коду переписки з
# підміненим Sitniks: історія, помилки вголос, текст, повтор, нове, фото.
if git diff --cached --name-only | grep -qE '^(loomiqadmin\.html|loomiq-chat\.js|worker/sitniks-proxy\.js|tests/chat-guard\.mjs)'; then
  node tests/chat-guard.mjs >/tmp/lq-chat-guard.log 2>&1 || {
    echo "✗ Діалог зламано — коміт зупинено. Подробиці: /tmp/lq-chat-guard.log"
    grep '✗' /tmp/lq-chat-guard.log
    exit 1
  }
  echo "✓ діалог цілий"
fi
# СТОРОЖ ВНУТРІШНІХ РОЗМОВ (21.10). Андрій: «переписка дизайнером… не
# відсилається». Зміна дошки/діалогу/адмінки — прогін кожного внутрішнього
# діалогу в обидва боки: акаунт ↔ графічний, ↔ вишивальний, ↔ цех, фото,
# «↪ від клієнта», картка відкрита у двох місцях.
if git diff --cached --name-only | grep -qE '^(loomiqadmin\.html|loomiq-design\.js|loomiq-chat\.js|tests/talk-guard\.mjs)'; then
  node tests/talk-guard.mjs >/tmp/lq-talk-guard.log 2>&1 || {
    echo "✗ Внутрішня розмова не доходить — коміт зупинено. Подробиці: /tmp/lq-talk-guard.log"
    grep '✗' /tmp/lq-talk-guard.log
    exit 1
  }
  echo "✓ внутрішні розмови живі"
fi
# ДРУК (DTF) У B2C (21.10). Нанесення позиції, черга DTF-дизайнера, ціни
# друку, закупка блоками, «Друк»: друкується → готово.
if git diff --cached --name-only | grep -qE '^(loomiqadmin\.html|loomiq-design\.js|tests/dtf\.mjs)'; then
  node tests/dtf.mjs >/tmp/lq-dtf.log 2>&1 || {
    echo "✗ Друк (DTF) зламано — коміт зупинено. Подробиці: /tmp/lq-dtf.log"
    grep '✗' /tmp/lq-dtf.log
    exit 1
  }
  echo "✓ друк (DTF) цілий"
fi
# ОДИН НОМЕР УСЮДИ (22.10): номер картки в Проблемних, Звірці, Фінансах,
# і перехід з нього в саму картку.
if git diff --cached --name-only | grep -qE '^(loomiqadmin\.html|loomiq-design\.js|loomiq-chat\.js|loomiq-money-core\.js|tests/order-no\.mjs)'; then
  node tests/order-no.mjs >/tmp/lq-order-no.log 2>&1 || {
    echo "✗ Номер замовлення розходиться — коміт зупинено. Подробиці: /tmp/lq-order-no.log"
    grep '✗' /tmp/lq-order-no.log
    exit 1
  }
  echo "✓ номер замовлення один"
fi
# РОЛІ ВИРОБНИЦТВА — ЛИШЕ B2C (22.10): розділ, своя дошка, що бачить,
# і разове доведення без нових прав.
if git diff --cached --name-only | grep -qE '^(loomiqadmin\.html|loomiq-design\.js|tests/prod-roles\.mjs)'; then
  node tests/prod-roles.mjs >/tmp/lq-prod-roles.log 2>&1 || {
    echo "✗ Ролі виробництва зламано — коміт зупинено. Подробиці: /tmp/lq-prod-roles.log"
    grep '✗' /tmp/lq-prod-roles.log
    exit 1
  }
  echo "✓ ролі виробництва цілі"
fi
# B2C НІКОЛИ НЕ ПОКАЗУЄ B2B-КАРТКУ (22.10): картка відділу або чесна
# панель з причиною; зламана зона — лише вона; номер від 2 000 001 = B2C.
if git diff --cached --name-only | grep -qE '^(loomiqadmin\.html|loomiq-design\.js|loomiq-chat\.js|tests/dept-only\.mjs)'; then
  node tests/dept-only.mjs >/tmp/lq-dept-only.log 2>&1 || {
    echo "✗ B2C показує не свою картку — коміт зупинено. Подробиці: /tmp/lq-dept-only.log"
    grep '✗' /tmp/lq-dept-only.log
    exit 1
  }
  echo "✓ B2C — лише картка відділу"
fi
# НОВЕ B2C — ЧЕРНЕТКОЮ (22.10): не в базі й не на дошці до «Створити
# замовлення»; платіж привʼязується лише в мить створення.
if git diff --cached --name-only | grep -qE '^(loomiqadmin\.html|loomiq-design\.js|loomiq-chat\.js|tests/new-draft\.mjs)'; then
  node tests/new-draft.mjs >/tmp/lq-new-draft.log 2>&1 || {
    echo "✗ Нове B2C-замовлення зламано — коміт зупинено. Подробиці: /tmp/lq-new-draft.log"
    grep '✗' /tmp/lq-new-draft.log
    exit 1
  }
  echo "✓ нове B2C — чернеткою"
fi
# ЗАСЛОНА ДОСТУПІВ (22.10). Андрій: «перші секунди відкривається все, а потім
# звужується… щоб йому навіть не показувалось». До приходу документа команди
# — лише «Завантажую доступи…», нікому не власник; приїхав — одразу своє.
if git diff --cached --name-only | grep -qE '^(loomiqadmin\.html|loomiq-design\.js|tests/db-link\.mjs)'; then
  node tests/db-link.mjs >/tmp/lq-db-link.log 2>&1 || {
    echo "✗ «Не читали — не пишемо» зламано (обрив підписки чи стара копія затирає новішу) — коміт зупинено. Подробиці: /tmp/lq-db-link.log"
    grep '✗' /tmp/lq-db-link.log
    exit 1
  }
  echo "✓ не читали — не пишемо"
fi
if git diff --cached --name-only | grep -qE '^(loomiqadmin\.html|tests/rollback\.mjs)'; then
  node tests/rollback.mjs >/tmp/lq-rollback.log 2>&1 || {
    echo "✗ Відкат картки на стан у минулому зламано — коміт зупинено. Подробиці: /tmp/lq-rollback.log"
    grep '✗' /tmp/lq-rollback.log
    exit 1
  }
  echo "✓ відкат картки цілий"
fi
if git diff --cached --name-only | grep -qE '^(loomiqadmin\.html|loomiq-design\.js|tests/acc-gate\.mjs)'; then
  node tests/acc-gate.mjs >/tmp/lq-acc-gate.log 2>&1 || {
    echo "✗ До приходу доступів щось показується або хтось стає власником — коміт зупинено. Подробиці: /tmp/lq-acc-gate.log"
    grep '✗' /tmp/lq-acc-gate.log
    exit 1
  }
  echo "✓ до приходу доступів — нічого"
fi

# ДОШКА B2C У ВСІХ ОДНАКОВА (22.10). Андрій: «статуси не паралельні».
# Знімок замовлень перемальовує відкритий розділ (repaintAfterOrders).
if git diff --cached --name-only | grep -qE '^(loomiqadmin\.html|loomiq-design\.js|tests/board-live\.mjs)'; then
  node tests/board-live.mjs >/tmp/lq-board-live.log 2>&1 || {
    echo "✗ Чужий рух картки не підтягується на дошку B2C — коміт зупинено. Подробиці: /tmp/lq-board-live.log"
    grep '✗' /tmp/lq-board-live.log
    exit 1
  }
  echo "✓ дошка B2C підтягує чужі рухи"
fi

# ОДНА РОЛЬ ЗА РАЗ (22.10). Андрій: «не обʼєднувати, а перемикати».
# Кілька ролей — перемикач зліва; все рахується з активної ролі.
if git diff --cached --name-only | grep -qE '^(loomiqadmin\.html|loomiq-design\.js|tests/role-switch\.mjs)'; then
  node tests/role-switch.mjs >/tmp/lq-role-switch.log 2>&1 || {
    echo "✗ Ролі знову складаються або перемикач зламано — коміт зупинено. Подробиці: /tmp/lq-role-switch.log"
    grep '✗' /tmp/lq-role-switch.log
    exit 1
  }
  echo "✓ одна роль за раз"
fi

# ВІДМОВА B2C (22.10): ставить лише акаунт і власник, з причиною; колонка
# «Відмова» в кінці акаунта; на інших дошках її немає; повернення в роботу.
if git diff --cached --name-only | grep -qE '^(loomiqadmin\.html|loomiq-design\.js|tests/refuse\.mjs)'; then
  node tests/refuse.mjs >/tmp/lq-refuse.log 2>&1 || {
    echo "✗ Відмова B2C зламана — коміт зупинено. Подробиці: /tmp/lq-refuse.log"
    grep '✗' /tmp/lq-refuse.log
    exit 1
  }
  echo "✓ відмова B2C ціла"
fi

# БРОНЬ НОМЕРА (22.10). Андрій: «щоб більше ніколи це не трапилось».
# Перед першим записом картки номер бронюється документом у базі.
if git diff --cached --name-only | grep -qE '^(loomiqadmin\.html|tests/order-reserve\.mjs)'; then
  node tests/order-reserve.mjs >/tmp/lq-order-reserve.log 2>&1 || {
    echo "✗ Бронь номера в адмінці зламана — коміт зупинено. Подробиці: /tmp/lq-order-reserve.log"
    grep '✗' /tmp/lq-order-reserve.log
    exit 1
  }
  echo "✓ номер бронюється в базі"
fi

# ДОГОВІР ДІАЛОГУ (23.10). Андрій: «діалог — в окрему зону». Нова залежність
# між loomiq-chat.js і адмінкою в будь-який бік — лише свідомо, через договір.
if git diff --cached --name-only | grep -qE '^(loomiqadmin\.html|loomiq-chat\.js|tests/chat-contract\.mjs)'; then
  node tests/chat-contract.mjs >/tmp/lq-chat-contract.log 2>&1 || {
    echo "✗ Договір діалогу порушено — коміт зупинено. Подробиці: /tmp/lq-chat-contract.log"
    grep '✗' /tmp/lq-chat-contract.log
    exit 1
  }
  echo "✓ договір діалогу дотримано"
fi

# СТОРОЖ РОЗДІЛІВ (21.10). Андрій: «вибиває із замовлення… щоб нас ніде
# ні звідки не вибивало». Зміна адмінки — прогін: кожен розділ, картка,
# конструктор, діалог + усе фонове (знімки, лічильники, доведення) —
# людина лишається там, де була.
if git diff --cached --name-only | grep -qE '^(loomiqadmin\.html|loomiq-design\.js|loomiq-chat\.js|index\.html|tests/stay-put\.mjs|tests/keep-place\.mjs)'; then
  node tests/stay-put.mjs >/tmp/lq-stay-put.log 2>&1 || {
    echo "✗ Щось вибиває людину з розділу — коміт зупинено. Подробиці: /tmp/lq-stay-put.log"
    grep '✗' /tmp/lq-stay-put.log
    exit 1
  }
  # 22.10: скрипти не стрибають, дошка після закриття картки — на місці.
  node tests/keep-place.mjs >/tmp/lq-keep-place.log 2>&1 || {
    echo "✗ Прокрутка відкочується на початок — коміт зупинено. Подробиці: /tmp/lq-keep-place.log"
    grep '✗' /tmp/lq-keep-place.log
    exit 1
  }
  echo "✓ нікуди не вибиває"
fi
exit 0
