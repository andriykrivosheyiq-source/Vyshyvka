  node tests/money-core.mjs >/tmp/lq-money-core.log 2>&1 || {
    echo "✗ Грошове ядро зламано — коміт зупинено. Подробиці: /tmp/lq-money-core.log"
    grep '✗' /tmp/lq-money-core.log
    exit 1
  }
  # Правила бази — коли є емулятор (інакше тест сам каже «пропущено»).
  if git diff --cached --name-only | grep -q '^firestore\.rules$'; then
    node tests/money-rules.mjs >/tmp/lq-money-rules.log 2>&1 || {
      echo "✗ Правила бази для грошей зламано — коміт зупинено. Подробиці: /tmp/lq-money-rules.log"
      grep '✗' /tmp/lq-money-rules.log
      exit 1
    }
  fi
    # 22.10: номер замовлення — лише заброньований (orderNos).
    node tests/order-nos.mjs >/tmp/lq-order-nos.log 2>&1 || {
      echo "✗ Правила бронювання номерів зламано — коміт зупинено. Подробиці: /tmp/lq-order-nos.log"
      grep '✗' /tmp/lq-order-nos.log
      exit 1
    }
  # Оплата на карту з «!» (21.10): справжня адмінка — менеджер вписує,
  # власник підтверджує, «не дійшло» не рахується.
