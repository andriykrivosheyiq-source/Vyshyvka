  for t in np-cod np-ship money-worker ship-abroad; do
    node tests/$t.mjs >/tmp/lq-$t.log 2>&1 || {
      echo "✗ Нова пошта / гроші зламано ($t) — коміт зупинено. Подробиці: /tmp/lq-$t.log"
      grep '✗' /tmp/lq-$t.log
