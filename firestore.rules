// ПРАВИЛА ДОСТУПУ ДО БАЗИ (Firestore)
//
// Куди вставити: Firebase Console → проєкт loomiq-admin → Firestore Database
// → вкладка Rules → замінити весь вміст цим файлом → Publish.
//
// Що тут описано — рівно те, що використовує сайт і адмінка:
//
//   reviews/*    відгуки. Відвідувач може лишити свій (одразу неопублікований)
//                і бачить лише схвалені. Публікує й видаляє — адмінка.
//
//   loomiq/photos  контент сайту: асортимент, фото, ціни, тексти.
//                Читає кожен відвідувач (інакше сайт порожній),
//                змінює лише той, хто увійшов в адмінку.
//
//   webOrders/*  замовлення з сайту. Відвідувач може лише СТВОРИТИ замовлення
//                (прочитати чи змінити чуже — ні). Адмінка забирає їх у Канбан
//                і позначає обробленими.
//
//   Усе інше (loomiq/state тощо) — лише авторизованим.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /reviews/{doc} {
      allow read: if resource.data.approved == true;
      allow create: if request.resource.data.approved == false
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 800
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if request.auth != null;
    }

    // Фото товарів: сайт читає публічно, змінює лише менеджер (під паролем)
    match /loomiq/photos {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Замовлення з сайту: клієнт лише створює, читає й обробляє тільки адмінка.
    // Перевірки нижче — щоб через відкритий create не засипали базу сміттям.
    match /webOrders/{doc} {
      allow create: if request.resource.data.imported == false
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 10
                    && request.resource.data.phone.size() <= 20
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50;
      allow read, update, delete: if request.auth != null;
    }

    // Персональні комерційні пропозиції. Клієнт відкриває свою сторінку без
    // реєстрації, тож читати дозволено всім — але лише за точною адресою
    // документа. Ім'я документа — випадковий токен на 12 символів: перебрати
    // його неможливо, а списком колекція не віддається (нижче немає list).
    // Створює й змінює пропозицію лише адмінка.
    match /offers/{token} {
      allow get: if true;
      allow write: if request.auth != null;

      // Клієнт зі своїм посиланням фіксує лише власний вибір: обраний тираж,
      // додані рекомендації, підтвердження або запит на зміни. Ціни, товари
      // й макети він змінити не може — правило пускає тільки ці поля.
      // Після підтвердження сторінка замикається: далі працює менеджер.
      //
      // `behaviour` тут теж свій: сторінка пише його разом із вибором (до
      // якого місця догортали, скільки часу минуло до першої дії). Без нього
      // в списку весь запис відхилявся — а разом із ним падав і сам вибір.
      allow update: if request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['selection', 'state', 'clientAction', 'events', 'clientAt', 'behaviour'])
        && resource.data.state != 'confirmed'
        && (!('events' in request.resource.data)
            || request.resource.data.events.size() <= 60);

      // Друга вкладка тієї самої сторінки — «Замовлення». Після оплати клієнт
      // погоджує тестовий відшив або просить правки, і це має працювати вже
      // ПІСЛЯ підтвердження — тобто там, де правило вище замикає сторінку.
      // Тому дозвіл окремий, і в ньому рівно поля відповіді: склад
      // замовлення, ціни й стан ним не змінюються.
      allow update: if request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['clientApprovals', 'events', 'clientAt'])
        && (!('events' in request.resource.data)
            || request.resource.data.events.size() <= 60);
    }

    // Картки Канбану: одна картка = один документ (ліміт 1 МБ на весь Канбан
    // раніше глушив збереження). Доступ лише з адмінки.
    match /kanbanOrders/{id} {
      allow read, write: if request.auth != null;
    }

    // Аналітика: один ПЕРЕГЛЯД СТОРІНКИ = один документ. Сесію звіт збирає
    // назад за полем sid. Окремі документи потрібні тому, що друга вкладка
    // або перехід на іншу сторінку інакше затирали б час, накопичений раніше.
    // Пише сайт анонімно, читає й підсумовує лише адмінка. Перевірки нижче —
    // щоб через відкритий запис не залили базу сміттям: сайт лише зі списку,
    // а час і глибина — в межах здорового глузду.
    // Персональних даних тут немає, лише випадковий ідентифікатор пристрою.
    //
    // Список сайтів більше не зашитий: посадкові створюються копією прямо в
    // адмінці (loomiq.net/?site=<ключ>), і новий ключ не має мовчки ламати
    // аналітику. Обмежуємо довжиною, а не переліком.
    match /an_sessions/{doc} {
      allow read: if request.auth != null;
      allow create, update: if request.resource.data.sid is string
                    && request.resource.data.sid.size() <= 32
                    && request.resource.data.vid is string
                    && request.resource.data.vid.size() <= 32
                    && request.resource.data.site is string
                    && request.resource.data.site.size() <= 24
                    && request.resource.data.day is string
                    && request.resource.data.day.size() == 10
                    && request.resource.data.sec is int
                    && request.resource.data.sec >= 0
                    && request.resource.data.sec <= 86400
                    && request.resource.data.depth is int
                    && request.resource.data.depth >= 0
                    && request.resource.data.depth <= 100;
      allow delete: if request.auth != null;
    }

    // Заявки без товару: «передзвоніть мені», консультація, запит із форми.
    // Раніше вони жили лише повідомленням у Telegram — у Канбані їх не було,
    // і за тиждень ніхто не пам'ятав, чи передзвонили. Клієнт лише створює,
    // читає й обробляє тільки адмінка. Перевірки — щоб через відкритий
    // create не залили базу сміттям.
    match /webLeads/{doc} {
      allow create: if request.resource.data.imported == false
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 5
                    && request.resource.data.phone.size() <= 20
                    && request.resource.data.page is string
                    && request.resource.data.page.size() <= 200
                    && request.resource.data.context is string
                    && request.resource.data.context.size() <= 200;
      allow read, update, delete: if request.auth != null;
    }

    // Діалоги з Telegram: один документ на співрозмовника. Пише Cloudflare
    // Worker, який приймає вебхук від Telegram — він звертається до бази без
    // входу, тож правило описує рівно ту форму запису, яку він робить.
    //
    // Читання дозволено точковим (get, без list): Worker перечитує документ,
    // щоб не загубити мітку пристрою з першого повідомлення. Імʼя документа —
    // числовий id чату; списком колекція не віддається, а самі поля — це те,
    // що в Telegram і так публічне (імʼя й @нік). Переписки тут немає.
    match /an_tg/{chat} {
      allow get: if true;
      allow list: if request.auth != null;
      // Адмінка позначає діалог полем kb, коли завела на нього картку —
      // без цього кожне оновлення створювало б нову картку на ту саму людину.
      allow create, update: if request.resource.data.uid is string
                    && request.resource.data.uid.size() <= 24
                    && request.resource.data.vid is string
                    && request.resource.data.vid.size() <= 32
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.user is string
                    && request.resource.data.user.size() <= 40
                    && request.resource.data.day is string
                    && request.resource.data.day.size() == 10
                    && request.resource.data.msgs is int
                    && request.resource.data.msgs >= 0
                    && request.resource.data.msgs <= 9999;
      allow delete: if request.auth != null;
    }

    // Сама переписка: один документ = одне повідомлення. Пише той самий
    // Worker (він без входу), читає лише адмінка — тому list тут закритий,
    // на відміну від батьківського документа.
    //
    // Створення відкрите, як і в an_tg: інакше Worker не записав би нічого.
    // Захист — форма запису й ліміти нижче. Ризик приймаємо свідомо: чужий
    // може підкинути в стрічку вигаданий рядок, але не може ні прочитати
    // чужу переписку, ні щось видалити.
    match /an_tg/{chat}/msgs/{m} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() <= 4000
                    && request.resource.data.at is string
                    && request.resource.data.at.size() <= 30
                    && request.resource.data.kind is string
                    && request.resource.data.kind.size() <= 12
                    && request.resource.data.mine is bool;
      allow update, delete: if request.auth != null;
    }

    // Денні підсумки. Рахує їх адмінка з сесій за добу — далі звіт відкривається
    // з десятка документів замість тисяч, і читання не впирається в ліміт.
    match /an_days/{day} {
      allow read, write: if request.auth != null;
    }

    // Все інше (ціни, стан Канбану) — лише авторизованим
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
